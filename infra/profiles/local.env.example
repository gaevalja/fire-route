# Host CLI reference values. Copy selected values into ignored root .env.
# Docker clients use CSE_CONTAINER_BASE_URL on their private Compose network.
FIREROUTE_PROFILE=local
CSE_BASE_URL=http://127.0.0.1:8080
CSE_CONTAINER_BASE_URL=http://cse:8080
CSE_BASE_RESOURCE=fire-route-dev
CSE_ORIGINATOR=CAdmin
CSE_MODE=real
MEC_MODE=unavailable
DEMO_MODE=simulator
