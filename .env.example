# Copy to .env; never commit .env
# Isolated local P0 development defaults; not production credentials or a MEC deployment.
FIREROUTE_PROFILE=local
CSE_BASE_URL=http://127.0.0.1:8080
# Client endpoint inside Docker; does not configure or deploy a remote CSE.
CSE_CONTAINER_BASE_URL=http://cse:8080
CSE_BASE_RESOURCE=fire-route-dev
CSE_RELEASE=4
CSE_ORIGINATOR=CAdmin
CSE_MQTT_URL=mqtt://127.0.0.1:1883
NOTIFICATION_PUBLIC_URL=http://127.0.0.1:8000/onem2m/notify
NOTIFICATION_BIND_HOST=127.0.0.1
NOTIFICATION_BIND_PORT=8000
REQUEST_TIMEOUT_SECONDS=5
STARTUP_TIMEOUT_SECONDS=60
NOTIFICATION_TIMEOUT_SECONDS=10
# P1 delivery/risk policy budgets are declared here; P0 does not implement route control.
SENSOR_TTL_SECONDS=30
MAX_CLOCK_SKEW_SECONDS=5
ACK_TIMEOUT_SECONDS=10
RETRY_LIMIT=2
RESOURCE_RETENTION_SECONDS=86400
EVIDENCE_ROOT=evidence
# Optional observed metadata written by the local CSE container; empty for external CSEs.
CSE_RUNTIME_INFO=
MEC_BASE_URL=
MEC_SERVICE_API=
MEC_ACCESS_TOKEN=
CSE_MODE=real
MEC_MODE=unavailable
DEMO_MODE=simulator
SYNTHETIC_SMOKE_THRESHOLD=70
# Optional actual MEC011 probe only; the ordinary demo stays MEC_MODE=unavailable.
# Set the exact service-management API root from the acquired environment.
MEC_SERVICE_MGMT_URL=
MEC_ENVIRONMENT=local-sandbox
MEC_APPLICATION_INSTANCE_ID=
MEC_API_TOKEN_FILE=
MEC_CA_FILE=
# Existing scoped oneM2M CNT for optional application-AE catalog storage.
MEC_CSE_TARGET_CONTAINER=
CSE_CA_FILE=
CSE_CLIENT_CERT=
CSE_CLIENT_KEY=
# External local MEC only (make p1-mec-external); the built-in runtime needs no URL.
# In Docker use host.docker.internal or an actual private host address, not host localhost.
MEC_LOCAL_SERVICE_MGMT_URL=
# Loopback port for the built-in official MEC011 component (make mec-local-up).
MEC_LOCAL_PORT=8090
# Separate registered-risk/project-IPE stack and optional dashboard.
MEC_SERVICES_PORT=8091
MEC_DASHBOARD_PORT=3002
# Optional host directory of FIRE_EVAC_* training runs for the demo model replay.
# FIRE_EVAC_RUNS_DIR=../fire_evac/runs
