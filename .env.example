# Copy to .env; never commit .env
# Isolated local P0 development defaults; not production credentials or a MEC deployment.
CSE_BASE_URL=http://127.0.0.1:8080
CSE_BASE_RESOURCE=fire-route-dev
CSE_RELEASE=4
CSE_ORIGINATOR=CAdmin
CSE_MQTT_URL=mqtt://127.0.0.1:1883
NOTIFICATION_PUBLIC_URL=http://127.0.0.1:8000/onem2m/notify
NOTIFICATION_BIND_HOST=127.0.0.1
NOTIFICATION_BIND_PORT=8000
REQUEST_TIMEOUT_SECONDS=5
STARTUP_TIMEOUT_SECONDS=60
NOTIFICATION_TIMEOUT_SECONDS=10
# P1 delivery/risk policy budgets are declared here; P0 does not implement route control.
SENSOR_TTL_SECONDS=30
MAX_CLOCK_SKEW_SECONDS=5
ACK_TIMEOUT_SECONDS=10
RETRY_LIMIT=2
RESOURCE_RETENTION_SECONDS=86400
EVIDENCE_ROOT=evidence
# Optional observed metadata written by the local CSE container; empty for external CSEs.
CSE_RUNTIME_INFO=
MEC_BASE_URL=
MEC_SERVICE_API=
MEC_ACCESS_TOKEN=
CSE_MODE=real
MEC_MODE=unavailable
DEMO_MODE=simulator
SYNTHETIC_SMOKE_THRESHOLD=70
